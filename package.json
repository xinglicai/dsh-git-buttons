{
  "name": "@dsh-external/dsh-git-buttons",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Git 常用操作按钮：会话顶部「Git 操作」页签，一键 status/add/commit/pull/push/branch/merge/stash/reset",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.3"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "git"],
  "author": "xinglicai",
  "license": "MIT"
}
